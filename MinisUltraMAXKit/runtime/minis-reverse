#!/bin/sh
set -eu
LIB="${MINIS_DEV_ULTRA_LIB:-/usr/local/lib/minis-dev-ultra}"
. "$LIB/ensure-python3.sh"
ensure_python3
if [ "$#" -lt 1 ]; then
  printf '%s\n' 'Usage: minis-reverse doctor | analyze <file.dylib> [--search term] | disasm <file.dylib> --at 0xADDRESS' >&2
  exit 2
fi
exec python3 "$LIB/reverse_lab.py" "$@"
